/* YUI DAILY — field notebook at dusk */

Screen {
    background: #171914;
    color: #e5e2d7;
}

* {
    scrollbar-size: 1 1;
    scrollbar-color: #555a4c;
    scrollbar-background: #171914;
}

HeaderBar {
    dock: top;
    height: 4;
    layout: horizontal;
    background: #1d201a;
    border-bottom: solid #373c31;
    padding: 0 2;
    align-vertical: middle;
}

#mark {
    width: 4;
    color: #d6a85f;
    text-style: bold;
    content-align: center middle;
}

#brand {
    width: 18;
    color: #e5e2d7;
    text-style: bold;
    content-align: left middle;
}

#header-date {
    width: 1fr;
    color: #85877e;
    content-align: center middle;
}

#header-status {
    width: 24;
    color: #8fa879;
    content-align: right middle;
}

#workspace {
    height: 1fr;
    layout: horizontal;
}

Sidebar {
    width: 23;
    height: 1fr;
    background: #1b1e18;
    border-right: solid #30342b;
    padding: 1 1;
}

.rail-label,
.panel-label {
    height: 2;
    color: #777a70;
    text-style: bold;
    padding: 0 1;
}

#view-list {
    height: auto;
    max-height: 11;
    background: transparent;
    margin-bottom: 1;
}

#view-list ListItem {
    height: 2;
    padding: 0 1;
    color: #92948a;
    background: transparent;
}

#view-list ListItem:hover {
    background: #262a22;
    color: #e5e2d7;
}

#view-list ListItem.active {
    background: #30342b;
    color: #e6b66b;
    border-left: thick #d6a85f;
}

#area-list {
    height: auto;
    color: #8c8f84;
    padding: 0 1;
}

#capture-legend {
    dock: bottom;
    height: 7;
    background: #20231c;
    border: tall #373c31;
    color: #85877e;
    padding: 1 2;
}

AgendaView {
    width: 1fr;
    height: 1fr;
    background: #171914;
    padding: 2 3 1 3;
}

#view-kicker {
    height: 1;
    color: #d6a85f;
    text-style: bold;
}

#view-title {
    height: 3;
    color: #f0ede3;
    text-style: bold;
    text-align: left;
    padding-top: 1;
}

#view-subtitle {
    height: 2;
    color: #85877e;
}

#quick-add {
    height: 3;
    background: #20231c;
    color: #eeeade;
    border: tall #3d4337;
    padding: 0 1;
}

#quick-add:focus {
    border: tall #d6a85f;
}

#capture-hint {
    height: 2;
    color: #65685f;
    padding: 0 1;
}

#agenda-list {
    height: 1fr;
    overflow-y: auto;
    background: transparent;
    color: #dddacf;
    border-top: solid #2b2f27;
    padding: 1 1 2 1;
}

#agenda-list:focus {
    border-top: solid #d6a85f;
}

FocusPanel {
    width: 31;
    height: 1fr;
    background: #1b1e18;
    border-left: solid #30342b;
    padding: 2 2;
}

#progress-bar {
    height: 2;
    color: #8fa879;
    text-style: bold;
    padding: 0 1;
}

#progress-copy,
#planned-time {
    height: 1;
    color: #93958b;
    padding: 0 1;
}

.detail-label {
    margin-top: 3;
}

#task-title {
    height: auto;
    max-height: 5;
    color: #efece1;
    text-style: bold;
    padding: 1;
    border-bottom: solid #34392f;
}

#task-meta {
    height: auto;
    color: #a2a49a;
    padding: 1;
}

#task-notes {
    height: auto;
    max-height: 8;
    color: #85877e;
    padding: 1;
}

#action-legend {
    dock: bottom;
    height: 7;
    color: #777a70;
    border-top: solid #30342b;
    padding: 1;
}

TaskEditorScreen,
ConfirmDeleteScreen {
    align: center middle;
    background: #10120ecc;
}

#editor-dialog {
    width: 68;
    height: 31;
    background: #20231c;
    border: round #555d4b;
    padding: 1 2;
}

#confirm-dialog {
    width: 54;
    height: 13;
    background: #20231c;
    border: round #6c493f;
    padding: 1 2;
}

.modal-kicker {
    height: 2;
    color: #d6a85f;
    text-style: bold;
}

.modal-copy {
    height: auto;
    color: #a3a59b;
    margin-bottom: 1;
}

.danger-copy {
    color: #d87562;
}

.field-label {
    height: 1;
    color: #777a70;
    text-style: bold;
}

.editor-row {
    height: 4;
}

.editor-field {
    width: 1fr;
    margin-right: 1;
}

.short-field {
    width: 10;
}

#editor-dialog Input {
    height: 3;
    background: #171914;
    border: tall #3d4337;
    color: #e5e2d7;
}

#editor-dialog Input:focus,
#edit-notes:focus {
    border: tall #d6a85f;
}

#edit-notes {
    height: 5;
    background: #171914;
    border: tall #3d4337;
    color: #e5e2d7;
}

#editor-error {
    height: 1;
    color: #d87562;
}

.modal-actions {
    height: 3;
    align-horizontal: right;
}

.modal-actions Button {
    min-width: 14;
    height: 3;
    margin-left: 1;
}

Footer {
    dock: bottom;
    height: 1;
    background: #10120e;
    color: #777a70;
}

Footer > .footer--key {
    background: transparent;
    color: #d6a85f;
    text-style: bold;
}

Footer > .footer--description {
    color: #777a70;
}

.compact #focus-panel {
    display: none;
}

.compact Sidebar {
    width: 20;
}

.compact AgendaView {
    padding-left: 2;
    padding-right: 2;
}
